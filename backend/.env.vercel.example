# Copy these into the Vercel project: easy-books-backend
# (Dashboard → Settings → Environment Variables, or `vercel env add`)

# Neon pooled connection string (Dashboard → Connection details → Pooled).
# Must include the `-pooler` host for serverless. Example:
# postgresql://user:pass@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# openssl rand -hex 32
JWT_SECRET_KEY=

# Comma-separated, no trailing slash. Match the frontend production URL.
FRONTEND_ORIGIN=https://easy-books-frontend.vercel.app

# Forces production JWT/DATABASE_URL checks.
APP_ENV=production

# Optional first-boot admin (only when the Neon DB is empty).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_COMPANY_NAME=My Company

# Serverless defaults (background loops are off on Vercel automatically).
# OVERDUE_SWEEP_ENABLED=false
# WEBHOOKS_ENABLED=false
# REVOKED_TOKEN_PRUNE_ENABLED=false
