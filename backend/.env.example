# Postgres connection string from Neon / Vercel Postgres / Supabase.
# On Vercel, use Neon's *pooled* URL (host contains `-pooler`):
#   postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# If unset, the backend falls back to local SQLite (dev only).
# In production (APP_ENV=production or VERCEL=1) startup fails if this is unset.
DATABASE_URL=

# JWT signing secret. Generate with: openssl rand -hex 32
# Required in production — startup fails if missing/default when APP_ENV=production.
JWT_SECRET_KEY=

# `development` or `production`. Affects cookie Secure flag and the JWT
# secret/default-key strict check on boot. Also accepted: ENV (alias).
APP_ENV=development

# Schema bootstrap mode at startup.
#   create_all  → SQLModel.metadata.create_all (default; safe in dev)
#   alembic     → skip startup DDL; run `alembic upgrade head` from CI instead
SCHEMA_BOOTSTRAP=create_all

# Comma-separated list of allowed CORS origins (no trailing slash).
# Example for production: https://easy-books.vercel.app,https://www.your-domain.com
FRONTEND_ORIGIN=http://localhost:3000

# One-time admin seed. Only used when the database is empty.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
SEED_COMPANY_NAME=My Company

# Module entitlements (#370). Default on: install is gated by tenant.plan +
# module_meta[id].entitled. Set false to roll back to unrestricted install.
# ENFORCE_MODULE_PLANS=true

# Easy-Books platform ops (not tenant owners). Empty = nobody can call /api/ops.
# OPS_ADMIN_EMAILS=ops@easy-books.app

# JSON map of private Marketplace listing id → extra tenant ids (ops overlay).
# Demo mill tenants are also granted Weighbridge via seed (module_meta).
# MARKETPLACE_PRIVATE_AUDIENCE={"partner.easybooks.weighbridge":[3]}

# Uploads: local disk in dev; production Vercel must use object storage
# (ephemeral FS). Set STORAGE_BACKEND to s3 plus bucket/region in the host
# environment — never commit cloud credentials.

# Billing: live Stripe keys and price ids live in the host environment, never
# git. Webhook URL: https://<api-host>/api/stripe/webhook
