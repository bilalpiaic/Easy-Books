# JWT secret — set a strong random value in production
JWT_SECRET_KEY=

# Comma-separated list of allowed frontend origins
FRONTEND_ORIGIN=http://localhost:3000

# Admin user seeded on first run (leave blank to skip seeding)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Company name used for the default tenant and settings
SEED_COMPANY_NAME=My Company
