# Postgres connection string from Neon / Vercel Postgres / Supabase.
# On Vercel, use Neon's *pooled* URL (host contains `-pooler`):
#   postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# If unset, the backend falls back to local SQLite (dev only).
# In production (APP_ENV=production or VERCEL=1) startup fails if this is unset.
DATABASE_URL=

# JWT signing secret. Generate with: openssl rand -hex 32
# Required in production — startup fails if missing/default when APP_ENV=production.
JWT_SECRET_KEY=

# `development` or `production`. Affects cookie Secure flag and the JWT
# secret/default-key strict check on boot. Also accepted: ENVIRONMENT, ENV.
# In production, SEED_DEMO / ALLOW_DEMO_LOGIN default off and REQUIRE_OWNER_TOTP
# defaults on unless an explicit env var overrides them (#419).
APP_ENV=development

# Schema bootstrap mode at startup.
#   create_all  → SQLModel.metadata.create_all (default; safe in dev)
#   alembic     → skip startup DDL; run APP_ROLE=migrate / alembic upgrade head
# Production refuses create_all (#424).
SCHEMA_BOOTSTRAP=create_all

# #424 — API replicas set APP_ROLE=api (no Alembic). Migrate job: APP_ROLE=migrate.
# APP_ROLE=api
# RUN_MIGRATIONS=false
# DATABASE_URL_DIRECT=
# DB_SSLMODE=require
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800

# #425 — API pods: RUN_BACKGROUND_JOBS=false. One ARQ worker owns crons.
# Desktop without Redis keeps in-process overdue/webhook loops.
# RUN_BACKGROUND_JOBS=false
# RUN_SCHEDULERS=false

# #427 — comma-separated IPs/CIDRs that may send X-Forwarded-For. Default 127.0.0.1.
# TRUSTED_PROXIES=127.0.0.1

# Comma-separated list of allowed CORS origins (no trailing slash).
# Example for production: https://easy-books.vercel.app,https://www.your-domain.com
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# One-time admin seed. Only used when the database is empty.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
SEED_COMPANY_NAME=My Company

# Module entitlements (#370). Default on: install is gated by tenant.plan +
# module_meta[id].entitled. Set false to roll back to unrestricted install.
# ENFORCE_MODULE_PLANS=true

# Easy-Books platform ops (not tenant owners). Empty = nobody can call /api/ops.
# OPS_ADMIN_EMAILS=ops@easy-books.app
# REQUIRE_OPS_TOTP=true

# Wave C #430 — invite-only signup in production. Allowlist is a comma email list.
# SIGNUP_ENABLED=false
# SIGNUP_ALLOWLIST=

# Kill-switch module ids (SaaS production sets healthcare). Desktop/on-prem leave empty.
# DISABLED_MODULES=healthcare

# JSON map of private Marketplace listing id → extra tenant ids (ops overlay).
# Demo mill tenants are also granted Weighbridge via seed (module_meta).
# MARKETPLACE_PRIVATE_AUDIENCE={"partner.easybooks.weighbridge":[3]}

# Uploads: STORAGE_BACKEND=local (desktop/compose) or s3 (Spaces). Keys are
# tenants/{tenant_id}/{logo|avatar|attachment|pdf}/{filename}. App URLs are
# authenticated /api/files/{key}. Optional one-off:
#   PYTHONPATH=. uv run python -m scripts.migrate_storage

# Billing: live Stripe keys and price ids live in the host environment, never
# git. Webhook URL: https://<api-host>/api/stripe/webhook

# #428 — Fernet for TOTP + Settings KV secrets. Passphrase or Fernet key.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DATA_ENCRYPTION_KEY=
# DATA_ENCRYPTION_PREVIOUS_KEYS=
# One-off: PYTHONPATH=. uv run python -m scripts.encrypt_settings

# git-pull updater is desktop/script only. Off in production / APP_ROLE pods.
# ENABLE_SELF_UPDATE=false
