# Backend API URL.
# Prefer 127.0.0.1 over "localhost" for local installs — on Windows,
# localhost often resolves to IPv6 ::1 while uvicorn binds IPv4 only.
# - Local / install-and-run:  http://127.0.0.1:8000
# - Vercel:                   https://<your-backend>.vercel.app
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
