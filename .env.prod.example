# Production env template for docker-compose.prod.yml (#116 / #419)
# Fail-closed defaults apply when APP_ENV (or ENVIRONMENT / ENV) is production:
#   SEED_DEMO=false, ALLOW_DEMO_LOGIN=false, REQUIRE_OWNER_TOTP=true
# Explicit env vars still override. JWT_SECRET_KEY is required at boot.
APP_ENV=production
POSTGRES_USER=easybooks
POSTGRES_PASSWORD=change-me
POSTGRES_DB=easybooks
DATABASE_URL=postgresql://easybooks:change-me@postgres:5432/easybooks
# Direct (non-pooler) URL for Alembic. Same as DATABASE_URL on compose.
DATABASE_URL_DIRECT=postgresql://easybooks:change-me@postgres:5432/easybooks
DB_SSLMODE=disable
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
APP_ROLE=api
RUN_MIGRATIONS=false
RUN_BACKGROUND_JOBS=false
TRUSTED_PROXIES=127.0.0.1
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=
SEED_DEMO=false
ALLOW_DEMO_LOGIN=false
REQUIRE_OWNER_TOTP=true
FRONTEND_ORIGIN=https://app.easy-books.app
STORAGE_BACKEND=local
# STORAGE_BACKEND=s3
# S3_BUCKET=
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
ALLOW_SSO_SIGNUP=false
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
API_HOST=api.easy-books.app
APP_HOST=app.easy-books.app
# Dedicated Fernet key for TOTP / settings secrets (not the JWT signing secret).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
# DATA_ENCRYPTION_PREVIOUS_KEYS=
ENABLE_SELF_UPDATE=false
