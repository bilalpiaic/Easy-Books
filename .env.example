# Easy-Books — Docker environment configuration
# Copy this file to .env, fill in the values, then run: docker compose up -d --build

# ── Required ─────────────────────────────────────────────────────────────────

# The URL your team uses to reach the app.
# Use your server's IP for a local network install, or your domain for internet.
# Examples:
#   APP_URL=http://192.168.1.100
#   APP_URL=http://books.mycompany.com
APP_URL=http://your-server-ip

# ── Recommended ──────────────────────────────────────────────────────────────

# JWT signing secret — sessions remain valid across restarts and container
# rebuilds only if this is set. Generate one with:
#   openssl rand -hex 32
# If left blank, local_config.py auto-generates and persists one in /data.
JWT_SECRET_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────

# Host port for nginx (default 80).
PORT=80

# Set to false to start with a clean database (no demo companies).
SEED_DEMO=true

# Switch from SQLite to PostgreSQL for higher concurrency.
# When set, Alembic manages the schema; local_config.py routes all queries here.
# DATABASE_URL=postgresql://user:password@host:5432/easybooks
DATABASE_URL=
