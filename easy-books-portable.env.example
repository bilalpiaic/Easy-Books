# Copy to easy-books-portable.env in the repo root (same folder as launch-cloud).
# That file is gitignored. Launchers and install-and-run load it automatically.
#
# Consumer cloud drives (OneDrive / Google Drive / Dropbox) only sync files.
# They do not run FastAPI. This env makes the *data* travel with the folder
# while processes still run on whichever PC you open the launcher on.

EB_PORTABLE=1

# Where SQLite + uploads + JWT secret live.
# Default when unset: <this-repo>/data
# Point at another synced folder if you want books off the code tree:
# EB_DATA_DIR=/Users/you/Library/CloudStorage/GoogleDrive-you/My Drive/Easy-Books-data
# EB_DATA_DIR=C:\Users\you\OneDrive\Easy-Books-data

# SQLite safety on synced folders (DELETE journal, 30s busy timeout).
EB_CLOUD_SAFE_SQLITE=true

# Refuse a second PC opening the same data folder at the same time.
EB_INSTANCE_LOCK=true

# First-run demo companies. Set false for a production books file.
# SEED_DEMO=false
